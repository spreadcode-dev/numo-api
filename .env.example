# HTTP port the API listens on (default: 3000)
PORT=3000

# Postgres superuser: owns the container, for setup and emergencies only.
# Never used by the API.
POSTGRES_USER=numo_superuser
POSTGRES_PASSWORD=change-me-superuser

# Connection used by the API (and by docker compose for the published port)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=numo_db

# API runtime user: SELECT, INSERT, UPDATE only (no DELETE, no DDL)
DB_APP_USER=numo_app_user
DB_APP_PASSWORD=change-me-app

# Migration user: DDL on schema public. Never used by the API at runtime.
DB_MIGRATION_USER=numo_migration_user
DB_MIGRATION_PASSWORD=change-me-migration

# Serves the API docs at /docs and /docs-json. Set to false to hide them (e.g. a public hosted environment).
SWAGGER_ENABLED=true

# Secret that signs login access tokens (HS256). Required, at least 32 bytes:
# the API refuses to start without it. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# How long an access token lasts: <number> followed by s, m or h (default: 15m)
JWT_ACCESS_TTL=15m

# Login and registration attempts allowed per IP, per route, within the window below (default: 5)
AUTH_THROTTLE_LIMIT=5

# Length of that window: <number> followed by s, m or h (default: 1m)
AUTH_THROTTLE_TTL=1m
