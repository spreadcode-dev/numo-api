# HTTP port the API listens on (default: 3000)
PORT=3000

# Postgres superuser: owns the container, for setup and emergencies only.
# Never used by the API.
POSTGRES_USER=numo_superuser
POSTGRES_PASSWORD=change-me-superuser

# Connection used by the API (and by docker compose for the published port)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=numo_db

# API runtime user: SELECT, INSERT, UPDATE only (no DELETE, no DDL)
DB_APP_USER=numo_app_user
DB_APP_PASSWORD=change-me-app

# Migration user: DDL on schema public. Never used by the API at runtime.
DB_MIGRATION_USER=numo_migration_user
DB_MIGRATION_PASSWORD=change-me-migration
